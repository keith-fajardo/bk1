{
  "name": "dbt-agent",
  "version": "0.4.40",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "setup": "bash scripts/install.sh",
    "bump": "bun scripts/bump.ts",
    "dev": "bun src/app.tsx",
    "build": "bun build --compile --define process.env.DEV='\"false\"' src/app.tsx --outfile dbt-agent",
    "build:review": "bun build --compile --define process.env.DEV='\"false\"' src/headless-review.ts --outfile bk1-review",
    "build:lint": "cd sidecars/lint && $HOME/.cargo/bin/cargo build --release && cp target/release/bk1-lint ~/.bk1/bk1-lint",
    "build:kimball": "bun scripts/build_kimball_db.ts",
    "deploy:assets": "bash scripts/deploy_assets.sh",
    "build:all": "bun run build:lint && bun run build && mv dbt-agent ~/.local/bin/bk1 && bun run deploy:assets",
    "relay": "bun src/playroom/relay-server.ts",
    "relay:deploy": "cd relay && npx wrangler deploy",
    "relay:dev": "cd relay && npx wrangler dev",
    "deps:check": "madge --extensions ts,tsx --circular src/",
    "deps:map": "madge --extensions ts,tsx --summary src/",
    "deps:impact": "madge --extensions ts,tsx src/ --depends",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "ink": "^5.2.0",
    "ink-spinner": "^5.0.0",
    "node-sql-parser": "^5.4.0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.0",
    "madge": "^8.0.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.0.0"
  }
}
