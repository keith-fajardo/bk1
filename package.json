{
  "name": "dbt-agent",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/install.sh",
    "dev": "bun src/app.tsx",
    "build": "bun build --compile src/app.tsx --outfile dbt-agent",
    "build:lint": "cd lint && $HOME/.cargo/bin/cargo build --release && cp target/release/bk1-lint ~/.bk1/bk1-lint",
    "build:kimball": "bun scripts/build_kimball_db.ts",
    "deploy:assets": "bash scripts/deploy_assets.sh",
    "build:all": "bun run build:lint && bun run build && mv dbt-agent ~/.local/bin/bk1 && bun run deploy:assets",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "ink": "^5.2.0",
    "ink-spinner": "^5.0.0",
    "node-sql-parser": "^5.4.0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.0",
    "typescript": "^5.0.0"
  }
}
