{
  "name": "bk1-context",
  "displayName": "bk1 - dbt coding agent",
  "description": "Coding agent for dbt projects — reviews modeling against Kimball and lints folders against dbt best practices",
  "version": "0.6.4",
  "publisher": "keithfajardo",
  "private": true,
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bk1",
          "title": "bk1",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "bk1": [
        {
          "id": "bk1.home",
          "name": "bk1"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bk1.home",
        "contents": "bk1 opens as a full editor panel — chat, pet, and play room all live there.\n\n[Open bk1](command:bk1.open)"
      }
    ],
    "commands": [
      {
        "command": "bk1.open",
        "title": "Open bk1",
        "category": "bk1",
        "icon": "media/icon.svg"
      },
      {
        "command": "bk1.stop",
        "title": "Stop bk1",
        "category": "bk1"
      },
      {
        "command": "bk1.show",
        "title": "Show bk1 Terminal (debug)",
        "category": "bk1"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bk1.open",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "bk1.open",
          "when": "view == bk1.home",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+t",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u0014" },
        "when": "bk1.terminalFocused"
      },
      {
        "key": "ctrl+l",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u000c" },
        "when": "bk1.terminalFocused"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p .",
    "watch": "tsc -p . -w"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}
