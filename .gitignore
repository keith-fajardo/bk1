.env*

# kimball.db IS committed (deterministic build artifact, ships with bk1).
# But never commit its SQLite sidecar files — those are transient runtime state.
skills_data/kimball/kimball.db-shm
skills_data/kimball/kimball.db-wal
skills_data/kimball/kimball.db-journal

# Rust build artifacts
lint/target/
target/

# colibri sidecar build artifacts (PyInstaller) — the binary ships via the
# release tarball, never git.
sidecars/colibri/.venv/
sidecars/colibri/build/
sidecars/colibri/dist/
sidecars/colibri/*.spec

# JS deps
node_modules/

# Runtime logs — transient, not build artifacts
logs/
